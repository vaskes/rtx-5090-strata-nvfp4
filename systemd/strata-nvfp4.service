# /etc/systemd/system/strata-nvfp4.service
# 
# Strata NVFP4 inference server on llmhost1 (RTX 5090).
# 
# DISABLED BY DEFAULT. This unit is installed but not enabled. The user
# starts it manually with `systemctl start strata-nvfp4` after verifying
# the host has enough RAM (>=120 GB for the 103 GB expert pack + OS).
# 
# This avoids auto-start on reboot when the host may not have the
# borrowed 128 GB RAM stick (currently from a sister production box).
# 
# To enable auto-start: `systemctl enable strata-nvfp4.service`
# To disable again:    `systemctl disable strata-nvfp4.service`
# To start manually:   `systemctl start strata-nvfp4`
# To stop:              `systemctl stop strata-nvfp4`
# To check status:      `systemctl status strata-nvfp4`

[Unit]
Description=Strata NVFP4 inference (RTX 5090, Qwen3.8-Flash-Next)
Documentation=https://github.com/vaskes/rtx-5090-strata-nvfp4
After=docker.service nvidia-persistenced.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# Type=exec + RemainAfterExit=yes: run.sh returns as soon as the container is started,
# and systemd keeps the unit "active" afterwards.
#
# NOT Type=oneshot: with it systemd treats the unit as finished and, because
# RemainAfterExit keeps it active, a later `systemctl start` does NOTHING ("Already
# running" - the container stays down) and `systemctl stop` does not run ExecStop.
# With Type=exec both commands do what they say, every time.
Type=exec
RemainAfterExit=yes

# Use a wrapper script for the full docker run command. This keeps the
# service file readable and lets us change container flags without touching
# systemd. The wrapper is in /opt/strata-nvfp4.service.d/run.sh
EnvironmentFile=-/opt/strata-nvfp4.service.d/env
ExecStart=/opt/strata-nvfp4.service.d/run.sh start
ExecStop=/opt/strata-nvfp4.service.d/run.sh stop
ExecReload=/opt/strata-nvfp4.service.d/run.sh restart

# Don't restart on failure — engine takes 1-3 min to start, and if
# model is gone or RAM is insufficient, we don't want a tight restart loop
# burning CPU. User monitors via `docker ps` / `docker logs`.
Restart=no

# Longer timeout because engine startup (model load 158 GB) takes 1-3 min
# and on first start the model download takes 30-60 min more.
TimeoutStartSec=3600
TimeoutStopSec=60

# Resource limits — Strata is GPU-heavy, not CPU-bound. Don't restrict
# memory (the engine mlock's its allocations) but cap CPU at 16 cores
# so the system has some headroom for ssh, monitoring, etc.
# CPUQuota=1600%  # 16 cores
# MemoryMax=120G  # safety: don't let Strata eat all 128 GB

StandardOutput=journal
StandardError=journal
SyslogIdentifier=strata-nvfp4

# Security hardening (basic — running an LLM server doesn't need fancy)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/strata-data /var/log/strata-nvfp4

# The unit is installed but LEFT DISABLED: the deploy script runs
# `systemctl disable`, so it never starts at boot.
#
# That is deliberate: the host may be running without the borrowed 128 GB RAM
# stick, and an auto-start would then take the host down. Start it by hand:
#   systemctl start strata-nvfp4
#
# The [Install] section is kept so that enabling it stays a deliberate
# one-liner (`systemctl enable strata-nvfp4`) rather than an edit.

[Install]
WantedBy=multi-user.target
